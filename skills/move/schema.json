{
  "type": "object",
  "properties": {
    "direction": {
      "type": "string",
      "enum": ["forward", "backward", "left", "right"],
      "description": "移动方向"
    },
    "speed": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 2.0,
      "description": "移动速度(m/s)"
    },
    "duration": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10.0,
      "description": "移动时长(秒)"
    }
  },
  "required": ["direction", "speed", "duration"]
}
